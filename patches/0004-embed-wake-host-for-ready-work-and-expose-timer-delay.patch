+
+/// Registers a coalesced readiness notification on Darwin's main queue.
+/// The callback may tick immediately or schedule a tick.
+/// Passing null unregisters and prevents further calls to the previous user.
+///
+/// # Safety
+/// Call after create, on the main JS thread. User stays live until unregister.
+#[cfg(target_os = "macos")]
+#[unsafe(no_mangle)]
+pub(crate) unsafe extern "C" fn bun_embed_set_wakeup(
+    callback: Option<unsafe extern "C" fn(*mut c_void)>, user: *mut c_void,
+) {
+    assert_eq!(JS_THREAD.get(), Some(&std::thread::current().id()));
+    let vm = embedded().0;
+    vm.event_loop().ensure_waker();
+    unsafe { BunEmbed__setWakeup(vm.event_loop().usockets_loop().fd(), callback, user) };
+}
+
+/// Milliseconds until the next timer, zero for ready work, NaN when idle.
+/// This query does not fire timers or invoke JavaScript.
+///
+/// # Safety
+/// Call after create, on its JS thread.
+#[unsafe(no_mangle)]
+pub(crate) unsafe extern "C" fn bun_embed_next_timeout() -> f64 {
+    assert_eq!(JS_THREAD.get(), Some(&std::thread::current().id()));
+    let vm = embedded().0;
+    let el = vm.event_loop();
+    if el.has_pending_tasks() || el.immediate_task_count() > 0 || el.has_yield_tasks()
+        || !el.imminent_gc_timer.load(core::sync::atomic::Ordering::Acquire).is_null() {
+        return 0.0;
+    }
+    crate::jsc_hooks::timer_all().next_timeout_ms()
+}
