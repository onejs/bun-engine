+    pub(crate) fn next_timeout_ms(&self) -> f64 {
+        self.assert_js_thread();
+        let regular = self.timers.peek().map(|timer| unsafe { (*timer).next.get() });
+        let wtf = self.wtf_timers.lock().peek().map(|timer| unsafe { (*timer).next.get() });
+        let Some(next) = Self::soonest(regular, wtf) else { return f64::NAN; };
+        if self.is_due_when_idle() { return 0.0; }
+        let now = Timespec::now(TimespecMockMode::ForceRealTime);
+        if !next.greater(&now) { return 0.0; }
+        let delay = next.duration(&now);
+        delay.sec as f64 * 1000.0 + delay.nsec as f64 / 1_000_000.0
+    }
