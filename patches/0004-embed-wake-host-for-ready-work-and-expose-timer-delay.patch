+#if OS(DARWIN)
+struct EmbedWakeup {
+    dispatch_source_t source;
+    void (*callback)(void*);
+    void* user;
+    bool suspended = false;
+};
+static EmbedWakeup* embedWakeup;
+
+extern "C" void BunEmbed__setWakeup(int fd, void (*callback)(void*), void* user)
+{
+    RELEASE_ASSERT(pthread_main_np());
+    if (auto* previous = std::exchange(embedWakeup, nullptr)) {
+        dispatch_source_cancel(previous->source);
+        if (previous->suspended)
+            dispatch_resume(previous->source);
+        dispatch_release(previous->source);
+    }
+    if (!callback)
+        return;
+    auto* registration = new EmbedWakeup {
+        dispatch_source_create(DISPATCH_SOURCE_TYPE_READ, fd, 0, dispatch_get_main_queue()), callback, user
+    };
+    RELEASE_ASSERT(registration->source);
+    embedWakeup = registration;
+    dispatch_set_context(registration->source, registration);
+    dispatch_source_set_event_handler_f(registration->source, [](void* context) {
+        auto* registration = static_cast<EmbedWakeup*>(context);
+        if (embedWakeup != registration)
+            return;
+        dispatch_suspend(registration->source);
+        registration->suspended = true;
+        registration->callback(registration->user);
+    });
+    dispatch_source_set_cancel_handler_f(registration->source, [](void* context) {
+        delete static_cast<EmbedWakeup*>(context);
+    });
+    dispatch_resume(registration->source);
+}
+
+extern "C" void BunEmbed__rearmWakeup()
+{
+    if (embedWakeup && embedWakeup->suspended) {
+        embedWakeup->suspended = false;
+        dispatch_resume(embedWakeup->source);
+    }
+}
+#endif
