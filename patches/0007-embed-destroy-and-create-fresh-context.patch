+    /// Finish an embedded evaluation while preserving the process-wide HTTP thread.
+    ///
+    /// # Safety
+    /// On the owning thread after the host detached all callbacks and references.
+    /// The caller forbade script and holds the JSC API lock that teardown consumes.
+    pub unsafe fn destroy_embedded() {
+        let this = Self::get_mut_ptr();
+        unsafe {
+            (*this).is_shutting_down.set(true);
+            (*this).run_cleanup_hooks();
+            Self::teardown(this, Teardown::Worker);
+            MAIN_THREAD_VM.store(core::ptr::null_mut(), core::sync::atomic::Ordering::Release);
+            VMHolder::set_cached_global_object(None);
+            VMHolder::set_vm(None);
+            let console = core::mem::replace(&mut (*this).console, core::ptr::null_mut());
+            if !console.is_null() {
+                bun_core::heap::destroy(console);
+            }
+            // The embedder's log is process-static, unlike the worker's.
+            std::alloc::dealloc(this.cast::<u8>(), core::alloc::Layout::new::<Self>());
+        }
+    }
