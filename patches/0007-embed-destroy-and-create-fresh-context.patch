+/// Releases the current context; the process and compiled program remain loaded.
+///
+/// # Safety
+/// On its creating thread, outside JS. Native callbacks must be detached and
+/// all host references to the context and its JS objects must be released.
+#[unsafe(no_mangle)]
+pub(crate) unsafe extern "C" fn bun_embed_destroy() {
+    assert_eq!(JS_THREAD.get(), Some(&std::thread::current().id()));
+    #[cfg(target_os = "macos")]
+    unsafe { BunEmbed__setWakeup(-1, None, core::ptr::null_mut()) };
+    let (vm, _) = unsafe { (*EMBEDDED.get()).take().expect("no embedded VM to destroy") };
+    let lock = vm.global().vm().get_api_lock();
+    vm.forbid_script();
+    unsafe { BunEmbed__undelayMicrotasks() };
+    // The teardown consumes the lock's reference to the old JSC VM.
+    core::mem::forget(lock);
+    unsafe { VirtualMachine::destroy_embedded() };
+    unsafe { crate::cli::Cli::embed_reset() };
