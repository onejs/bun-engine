diff --git a/src/runtime/cli/mod.rs b/src/runtime/cli/mod.rs
index bd41f82898..1fa86c7469 100644
--- a/src/runtime/cli/mod.rs
+++ b/src/runtime/cli/mod.rs
@@ -401,6 +401,27 @@ pub(crate) mod cli {
             bun_crash_handler::handle_root_error(err);
         }
     }
+
+    /// `start` for an embedder: the same process setup, then the embedded
+    /// program's VM on the calling thread with its entry not yet run.
+    pub(crate) fn embed_start(
+    ) -> Option<(&'static bun_jsc::virtual_machine::VirtualMachine, &'static [u8])> {
+        bun_crash_handler::cli_state::set_main_thread_id(bun_threading::current_thread_id());
+        bun_core::set_start_time(bun_core::time::nano_timestamp());
+        // SAFETY: called once, before any other thread touches `LOG_` or the arena.
+        let log = unsafe { (*LOG_.get()).write(bun_ast::Log::init()) };
+        unsafe { (*super::CLI_ARENA.get()).write(bun_alloc::Arena::new()) };
+        match Command::embed_boot(log) {
+            Ok(booted) => booted,
+            Err(err) => {
+                let _ = log.print(std::ptr::from_mut::<bun_core::io::Writer>(
+                    bun_core::Output::error_writer(),
+                ));
+                bun_core::Output::err(err, "the embedded program failed to start", ());
+                None
+            }
+        }
+    }
 }
 pub(crate) use cli as Cli;
 
@@ -1219,6 +1240,27 @@ pub(crate) mod command {
         graph: *mut bun_standalone_graph::Graph,
         log: &mut bun_ast::Log,
     ) -> CmdResult {
+        let (ctx, entry_name, graph) = standalone_context(graph, log)?;
+        super::run_command::RunCommand::boot_standalone(ctx, entry_name, graph)?;
+        Ok(())
+    }
+
+    /// The embedded program's VM, ready for its entry, without Bun's event loop.
+    /// `None` when this image holds no compiled program.
+    pub(crate) fn embed_boot(
+        log: &mut bun_ast::Log,
+    ) -> crate::Result<Option<(&'static bun_jsc::virtual_machine::VirtualMachine, &'static [u8])>> {
+        let Some(graph) = bun_standalone_graph::Graph::from_executable()? else {
+            return Ok(None);
+        };
+        let (ctx, entry_name, graph) = standalone_context(graph, log)?;
+        Ok(Some(super::run_command::RunCommand::boot_standalone_vm(ctx, entry_name, graph)?))
+    }
+
+    fn standalone_context(
+        graph: *mut bun_standalone_graph::Graph,
+        log: &mut bun_ast::Log,
+    ) -> crate::Result<(&'static mut ContextData, Box<[u8]>, &'static bun_standalone_graph::Graph)> {
         // SAFETY: `from_executable` returns a non-null `*mut Graph` whose
         // backing storage is process-static (owned by the executable image).
         let graph: &'static bun_standalone_graph::Graph = unsafe { &*graph };
@@ -1296,8 +1338,7 @@ pub(crate) mod command {
             .collect();
 
         let entry_name = graph.main_module_path().to_vec().into_boxed_slice();
-        super::run_command::RunCommand::boot_standalone(ctx, entry_name, graph)?;
-        Ok(())
+        Ok((ctx, entry_name, graph))
     }
 
     /// `bun [run] <script>` / `bun --version` / bare `bun`. The dominant tag
diff --git a/src/runtime/cli/run_command.rs b/src/runtime/cli/run_command.rs
index bc9401910c..9e4c87f8b3 100644
--- a/src/runtime/cli/run_command.rs
+++ b/src/runtime/cli/run_command.rs
@@ -1213,6 +1213,23 @@ Full documentation is available at <magenta>https://bun.com/docs/cli/run<r>
         entry_path: Box<[u8]>,
         graph: &'static bun_standalone_graph::Graph,
     ) -> crate::Result<()> {
+        let (vm, entry) = Self::boot_standalone_vm(ctx, entry_path, graph)?;
+        Run {
+            ctx,
+            vm,
+            entry_path: Some(entry),
+            unchecked: None,
+        }
+        .start()
+    }
+
+    /// Everything `boot_standalone` does before the event loop, so an embedder
+    /// can own the thread and run the entry itself.
+    pub(crate) fn boot_standalone_vm(
+        ctx: &mut ContextData,
+        entry_path: Box<[u8]>,
+        graph: &'static bun_standalone_graph::Graph,
+    ) -> crate::Result<(&'static VirtualMachine, &'static [u8])> {
         use bun_standalone_graph::StandaloneModuleGraph::Flags as GraphFlags;
 
         crate::cli::startup_options::refuse_code_the_compiler_did_not_see();
@@ -1307,13 +1324,7 @@ Full documentation is available at <magenta>https://bun.com/docs/cli/run<r>
         );
         Self::do_preconnect(&ctx.runtime_options.preconnect);
 
-        Run {
-            ctx,
-            vm,
-            entry_path: Some(entry),
-            unchecked: None,
-        }
-        .start()
+        Ok((vm, entry))
     }
