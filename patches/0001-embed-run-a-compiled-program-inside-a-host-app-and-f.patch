diff --git a/src/jsc/bindings/c-bindings.cpp b/src/jsc/bindings/c-bindings.cpp
index f9a6ec7019..51b58d362a 100644
--- a/src/jsc/bindings/c-bindings.cpp
+++ b/src/jsc/bindings/c-bindings.cpp
@@ -1515,13 +1515,33 @@ struct BlobHeader {
 
 #if OS(DARWIN)
 
+#include <mach-o/dyld.h>
 #include <mach-o/getsect.h>
 #include <mach-o/ldsyms.h>
 
 extern "C" BlobHeader __attribute__((section("__BUN,__bun"))) BUN_COMPILED = { 0, 0 };
 
+// An App Store binary may have only one executable segment, so an app built on
+// this runtime as a library carries its program in __TEXT,__bun of another image.
+static uint64_t* programInTextOfLoadedImage()
+{
+    for (uint32_t i = 0, count = _dyld_image_count(); i < count; i++) {
+        unsigned long size = 0;
+        auto* header = reinterpret_cast<const struct mach_header_64*>(_dyld_get_image_header(i));
+        uint8_t* data = getsectiondata(header, "__TEXT", "__bun", &size);
+        if (!data || size < sizeof(uint64_t))
+            continue;
+        auto* length = reinterpret_cast<uint64_t*>(data);
+        if (*length <= size - sizeof(uint64_t))
+            return length;
+    }
+    return nullptr;
+}
+
 extern "C" uint64_t* Bun__getStandaloneModuleGraphMachoLength()
 {
+    if (!BUN_COMPILED.size)
+        return programInTextOfLoadedImage();
     // A corrupt file can claim any length, so check it against the section size from the load command.
     unsigned long sectionSize = 0;
     uint8_t* sectionData = getsectiondata(&_mh_execute_header, "__BUN", "__bun", &sectionSize);
diff --git a/src/runtime/bin_entry/embed.rs b/src/runtime/bin_entry/embed.rs
new file mode 100644
index 0000000000..f4be364d41
--- /dev/null
+++ b/src/runtime/bin_entry/embed.rs
@@ -0,0 +1,96 @@
+//! Entry points for a host that owns the thread, such as a React Native engine.
+//! The host calls `bun_embed_create` on its JS thread, installs its own globals
+//! on the returned `JSGlobalContextRef`, runs the program with
+//! `bun_embed_run_entry`, and calls `bun_embed_tick` where it drains microtasks.
+//! Every call after `bun_embed_create` must come from that same thread.
+
+use core::ffi::{c_char, c_int, c_void};
+
+use bun_jsc::js_promise::Status as PromiseStatus;
+use bun_jsc::virtual_machine::VirtualMachine;
+
+static EMBEDDED: bun_core::RacyCell<Option<(&'static VirtualMachine, &'static [u8])>> =
+    bun_core::RacyCell::new(None);
+
+fn embedded() -> (&'static VirtualMachine, &'static [u8]) {
+    // SAFETY: written once by `bun_embed_create` on the JS thread, read only there.
+    unsafe { (*EMBEDDED.get()).expect("bun_embed_create was not called") }
+}
+
+/// Returns the program's `JSGlobalContextRef`, or null when this image has no
+/// compiled program or it failed to start (the reason is printed to stderr).
+///
+/// # Safety
+/// `argv` must hold `argc` NUL-terminated strings that live for the process.
+/// Call once per process.
+#[unsafe(no_mangle)]
+pub(crate) unsafe extern "C" fn bun_embed_create(argc: c_int, argv: *const *const c_char) -> *mut c_void {
+    #[cfg(any(target_os = "android", all(target_os = "linux", not(target_env = "gnu"))))]
+    {
+        unsafe extern "C" {
+            safe fn Bun__askForAddressSpaceToStart();
+        }
+        Bun__askForAddressSpaceToStart();
+    }
+    unsafe { bun_core::init_argv(argc, argv) };
+    bun_crash_handler::init();
+    super::use_mimalloc_in_dependencies();
+    bun_core::output::stdio::init();
+    bun_core::StackCheck::configure_thread();
+
+    let Some((vm, entry)) = crate::cli::Cli::embed_start() else {
+        bun_core::output::flush();
+        return core::ptr::null_mut();
+    };
+    // Held for the life of the thread, as `Run::start` holds it, so JSC never
+    // drains microtasks behind the host's back.
+    core::mem::forget(vm.global().vm().get_api_lock());
+    // SAFETY: first and only write, on the JS thread.
+    unsafe { *EMBEDDED.get() = Some((vm, entry)) };
+    // A `JSGlobalContextRef` is the `JSGlobalObject` pointer (JSC's APICast.h).
+    std::ptr::from_ref(vm.global()).cast_mut().cast()
+}
+
+/// Runs the compiled entry module. Returns 0 on success. On a thrown error it
+/// returns 1 and writes the thrown value (a `JSValueRef`) to `exception`; on a
+/// load failure it returns 2 after printing the reason.
+///
+/// # Safety
+/// After a successful `bun_embed_create`, on its thread; `exception` is null or writable.
+#[unsafe(no_mangle)]
+pub(crate) unsafe extern "C" fn bun_embed_run_entry(exception: *mut *const c_void) -> c_int {
+    let (vm, entry) = embedded();
+    let status = match vm.load_entry_point(Some(entry)) {
+        Ok(promise) => {
+            // SAFETY: a live GC cell returned by the module loader.
+            let promise = unsafe { &mut *promise };
+            if promise.status() == PromiseStatus::Rejected {
+                let thrown = promise.result(vm.jsc_vm());
+                promise.set_handled();
+                if !exception.is_null() {
+                    // SAFETY: caller-provided out slot. A `JSValueRef` is the encoded value.
+                    unsafe { *exception = thrown.encoded() as *const c_void };
+                }
+                1
+            } else {
+                vm.tick();
+                0
+            }
+        }
+        Err(err) => {
+            bun_core::Output::err(err, "the embedded program's entry failed to load", ());
+            2
+        }
+    };
+    bun_core::output::flush();
+    status
+}
+
+/// Runs ready tasks and drains microtasks without blocking.
+///
+/// # Safety
+/// After a successful `bun_embed_create`, on its thread.
+#[unsafe(no_mangle)]
+pub(crate) unsafe extern "C" fn bun_embed_tick() {
+    embedded().0.tick();
+}
