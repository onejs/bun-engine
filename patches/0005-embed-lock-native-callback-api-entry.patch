--- a/src/jsc/bindings/bindings.cpp
+++ b/src/jsc/bindings/bindings.cpp
@@ -5765,6 +5765,16 @@
+extern "C" __attribute__((visibility("default"))) void bun_embed_lock(JSC::JSGlobalObject* globalObject)
