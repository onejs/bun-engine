+    globalObject->vm().apiLock().lock();
+}
+
+extern "C" __attribute__((visibility("default"))) void bun_embed_unlock(JSC::JSGlobalObject* globalObject)
+{
+    globalObject->vm().apiLock().unlock();
+}
