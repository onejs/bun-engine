@@ -456,6 +461,22 @@
 TimeZone* U_EXPORT2
 TimeZone::detectHostTimeZone()
 {
+#if U_PLATFORM_IS_DARWIN_BASED
+    // Cocoa already tracks the system zone. The generic Unix path can scan
+    // the entire zoneinfo directory when localtime is a regular file.
+    if (!std::getenv("TZ")) {
+        if (CFTimeZoneRef system = CFTimeZoneCopySystem()) {
+            char name[256];
+            const bool named = CFStringGetCString(CFTimeZoneGetName(system), name, sizeof(name), kCFStringEncodingASCII);
+            CFRelease(system);
+            if (named) {
+                if (TimeZone* zone = createSystemTimeZone(UnicodeString(name, -1, US_INV)))
+                    return zone;
+            }
+        }
+    }
+#endif
+
